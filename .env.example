# Google Sheets API - 서비스 계정 인증 정보
# Google Cloud Console > IAM > 서비스 계정 > 키 생성(JSON)에서 복사

GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# 개행 문자(\n)를 그대로 유지해야 합니다. 아래처럼 큰따옴표 안에 \n으로 입력하세요.
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAK...\n-----END RSA PRIVATE KEY-----\n"

# 연동할 Google Sheets 스프레드시트 ID
# URL에서 추출: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# 데이터를 기록할 시트(탭) 이름
GOOGLE_SHEET_NAME=IR_Data
